@@ -0,0 +1,190 @@
+/**
+ * Products and categories for the Inventory screens. One function per thing the page does, with two implementations chosen by build mode:
+ *  - legacy: the original Supabase queries, moved here unchanged;
+ *  - api: the LeenTrack PHP API, with answers converted to the shape the page already renders (numbers, `categories.name`, `price`/`cost` aliases).
+ * Pages never see the difference.
+ */
+import { supabase } from "@/lib/supabase"
+import { api, fetchAll, isApiMode, ApiError } from "@/lib/api"
+
+export interface Product {
+  id: string
+  business_id: string
+  name: string
+  description: string | null
+  sku: string | null
+  barcode: string | null
+  price: number
+  cost: number
+  cost_price: number
+  selling_price: number
+  stock_quantity: number
+  min_stock_level: number
+  reorder_level: number
+  category_id: string | null
+  user_id: string | null
+  is_active: boolean
+  image_url: string | null
+  item_type?: "product" | "service"
+  created_at: string
+  updated_at: string
+  categories?: { name: string }
+}
+
+export interface Category {
+  id: string
+  name: string
+}
+
+export interface ProductInput {
+  name: string
+  description: string | null
+  sku: string | null
+  barcode: string | null
+  selling_price: number
+  cost_price: number
+  stock_quantity: number
+  min_stock_level: number
+  reorder_level: number
+  category_id: string | null
+  item_type: "product" | "service"
+}
+
+const money = (v: unknown): number => (v === null || v === undefined || v === "" ? 0 : Number(v))
+
+export function toLegacyProduct(p: any, businessId: string, categories: Category[]): Product {
+  const cat = categories.find((c) => c.id === p.category_id)
+  return {
+    id: p.id,
+    business_id: businessId,
+    name: p.name,
+    description: p.description ?? null,
+    sku: p.sku ?? null,
+    barcode: p.barcode ?? null,
+    price: money(p.selling_price),
+    cost: money(p.cost_price),
+    cost_price: money(p.cost_price),
+    selling_price: money(p.selling_price),
+    stock_quantity: Number(p.stock_quantity ?? 0),
+    min_stock_level: Number(p.min_stock_level ?? 0),
+    reorder_level: Number(p.reorder_level ?? 0),
+    category_id: p.category_id ?? null,
+    user_id: null,
+    is_active: p.is_active !== false,
+    image_url: p.image_url ?? null,
+    item_type: p.item_type === "service" ? "service" : "product",
+    created_at: p.created_at ?? "",
+    updated_at: p.updated_at ?? "",
+    ...(cat ? { categories: { name: cat.name } } : {}),
+  }
+}
+
+export async function listCategories(businessId: string): Promise<Category[]> {
+  if (isApiMode()) {
+    const rows = await fetchAll<any>(api(), "/categories")
+    return rows.map((c) => ({ id: c.id, name: c.name })).sort((a, b) => a.name.localeCompare(b.name))
+  }
+  const { data } = await supabase.from("categories").select("id, name").eq("business_id", businessId).order("name")
+  return data || []
+}
+
+export async function listProducts(businessId: string): Promise<Product[]> {
+  if (isApiMode()) {
+    const [rows, cats] = await Promise.all([fetchAll<any>(api(), "/products"), listCategories(businessId)])
+    return rows.map((p) => toLegacyProduct(p, businessId, cats)).sort((a, b) => a.name.localeCompare(b.name))
+  }
+  const { data, error } = await supabase.from("products").select("*, categories (name)").eq("business_id", businessId).order("name")
+  if (error) throw error
+  return (data as Product[]) || []
+}
+
+/** Create or update. In API mode stock is not a product field: a changed quantity becomes an audited stock count. */
+export async function saveProduct(input: ProductInput, ctx: { businessId: string; userId: string; editing?: Product | null }): Promise<void> {
+  const isService = input.item_type === "service"
+  if (isApiMode()) {
+    try {
+      const body: Record<string, unknown> = {
+        name: input.name,
+        description: input.description,
+        sku: input.sku,
+        barcode: input.barcode,
+        selling_price: input.selling_price.toFixed(2),
+        cost_price: input.cost_price.toFixed(2),
+        min_stock_level: input.min_stock_level,
+        reorder_level: input.reorder_level,
+        category_id: input.category_id,
+        item_type: input.item_type,
+      }
+      if (ctx.editing) {
+        await api().patch(`/products/${ctx.editing.id}`, body)
+        if (!isService && input.stock_quantity !== ctx.editing.stock_quantity) {
+          const locs = (await api().get<any[]>("/locations")).data
+          const main = locs.find((l) => l.is_default) ?? locs[0]
+          await api().post("/stock/adjustments", { product_id: ctx.editing.id, location_id: main.id, new_quantity: input.stock_quantity, reason: "count", note: "Edited in the inventory screen" })
+        }
+      } else {
+        await api().post("/products", { ...body, stock_quantity: isService ? 0 : input.stock_quantity })
+      }
+    } catch (e) {
+      throw toError(e)
+    }
+    return
+  }
+  const payload = {
+    ...input,
+    user_id: ctx.userId,
+    business_id: ctx.businessId,
+    is_active: true,
+    updated_at: new Date().toISOString(),
+  }
+  if (ctx.editing) {
+    const { error } = await supabase.from("products").update(payload).eq("id", ctx.editing.id)
+    if (error) throw error
+  } else {
+    const { error } = await supabase.from("products").insert([{ ...payload, created_at: new Date().toISOString() }])
+    if (error) throw error
+  }
+}
+
+/** API mode archives (the record stays for old sales); legacy mode keeps its original hard delete. */
+export async function deleteProduct(id: string): Promise<void> {
+  if (isApiMode()) {
+    try { await api().delete(`/products/${id}`) } catch (e) { throw toError(e) }
+    return
+  }
+  const { error } = await supabase.from("products").delete().eq("id", id)
+  if (error) throw error
+}
+
+function toError(e: unknown): Error {
+  if (e instanceof ApiError) {
+    const first = Object.values(e.fields)[0]?.[0]
+    return new Error(first ?? (e.isNetwork ? "Network error. Please check your connection." : e.message))
+  }
+  return e instanceof Error ? e : new Error("Something went wrong.")
+}
+
+export interface StockLevelRow {
+  id: string
+  name: string
+  stock_quantity: number
+  reorder_level: number | null
+  min_stock_level: number | null
+  item_type?: "product" | "service"
+}
+
+/** Active items with their stock numbers: what the low-stock banner needs on every page. */
+export async function listStockLevels(businessId: string): Promise<StockLevelRow[]> {
+  if (isApiMode()) {
+    const rows = await fetchAll<any>(api(), "/products")
+    return rows
+      .filter((p) => p.is_active !== false)
+      .map((p) => ({ id: p.id, name: p.name, stock_quantity: Number(p.stock_quantity ?? 0), reorder_level: p.reorder_level ?? null, min_stock_level: p.min_stock_level ?? null, item_type: p.item_type === "service" ? "service" : "product" }))
+  }
+  const { data } = await supabase
+    .from("products")
+    .select("id, name, stock_quantity, reorder_level, min_stock_level, item_type")
+    .eq("business_id", businessId)
+    .eq("is_active", true)
+  return (data ?? []) as StockLevelRow[]
+}
