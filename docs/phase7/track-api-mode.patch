+/** A failure reported by the LeenTrack API (or the network) in a form screens can act on. */
+export class ApiError extends Error {
+  readonly code: string
+  readonly status: number | null
+  readonly fields: Record<string, string[]>
+  readonly requestId: string | null
+
+  constructor(init: { code: string; message: string; status?: number | null; fields?: Record<string, string[]>; requestId?: string | null }) {
+    super(init.message)
+    this.name = "ApiError"
+    this.code = init.code
+    this.status = init.status ?? null
+    this.fields = init.fields ?? {}
+    this.requestId = init.requestId ?? null
+  }
+
+  /** The browser could not reach the server (offline, DNS, CORS misconfiguration, timeout). */
+  get isNetwork(): boolean {
+    return this.code === "network_error"
+  }
+}
