new file mode 100644
index 0000000..a77a8ce
--- /dev/null
+++ b/lib/api/token-store.ts
@@ -0,0 +1,44 @@
+/**
+ * Where the refresh token lives between page loads. The short-lived access token is never stored (memory only).
+ * Default: localStorage, which matches what supabase-js did. A stricter option (httpOnly cookie via a Next.js route handler) is documented
+ * in docs/16 of the rebuild repository as a hardening step.
+ */
+export interface TokenStore {
+  getRefreshToken(): string | null
+  setRefreshToken(token: string): void
+  getBusinessId(): string | null
+  setBusinessId(id: string): void
+  clear(): void
+}
+
+export class MemoryTokenStore implements TokenStore {
+  private refresh: string | null = null
+  private business: string | null = null
+  getRefreshToken() { return this.refresh }
+  setRefreshToken(t: string) { this.refresh = t }
+  getBusinessId() { return this.business }
+  setBusinessId(id: string) { this.business = id }
+  clear() { this.refresh = null; this.business = null }
+}
+
+const REFRESH_KEY = "lt_refresh_token"
+const BUSINESS_KEY = "lt_business_id"
+
+/** localStorage with every access guarded: private windows and blocked storage must degrade to "signed out", never throw. */
+export class LocalStorageTokenStore implements TokenStore {
+  private read(k: string): string | null {
+    try { return typeof window === "undefined" ? null : window.localStorage.getItem(k) } catch { return null }
+  }
+  private write(k: string, v: string | null) {
+    try {
+      if (typeof window === "undefined") return
+      if (v === null) window.localStorage.removeItem(k)
+      else window.localStorage.setItem(k, v)
+    } catch { /* storage blocked: the session lasts until reload */ }
+  }
+  getRefreshToken() { return this.read(REFRESH_KEY) }
+  setRefreshToken(t: string) { this.write(REFRESH_KEY, t) }
+  getBusinessId() { return this.read(BUSINESS_KEY) }
+  setBusinessId(id: string) { this.write(BUSINESS_KEY, id) }
+  clear() { this.write(REFRESH_KEY, null); this.write(BUSINESS_KEY, null) }
+}
