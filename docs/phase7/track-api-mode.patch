diff --git a/contexts/api-session.tsx b/contexts/api-session.tsx
new file mode 100644
index 0000000..a557c06
--- /dev/null
+++ b/contexts/api-session.tsx
@@ -0,0 +1,291 @@
+"use client"
+
+/**
+ * API-mode providers: the same `useAuth()` / `useBusiness()` shapes the pages already use, backed by the LeenTrack PHP API instead of Supabase.
+ * Only mounted when NEXT_PUBLIC_API_BASE_URL is set at build time (see lib/api/mode.ts).
+ */
+import type React from "react"
+import { createContext, useCallback, useContext, useEffect, useMemo, useState } from "react"
+import { AuthContext, type AuthContextType } from "./auth-context"
+import { BusinessContext, type Business, type BusinessContextType } from "./business-context"
+import { api, ApiError, onSessionExpired, type Me, type Membership } from "@/lib/api"
+
+interface ApiSessionValue {
+  me: Me | null
+  memberships: Membership[]
+  businessId: string | null
+  businessDetails: Record<string, any> | null
+  loading: boolean
+  selectBusiness: (id: string) => Promise<void>
+  reloadBusiness: () => Promise<void>
+  reloadMemberships: () => Promise<void>
+}
+
+const ApiSessionContext = createContext<ApiSessionValue | null>(null)
+
+function useApiSession(): ApiSessionValue {
+  const v = useContext(ApiSessionContext)
+  if (!v) throw new Error("ApiSessionContext is missing: wrap the app in AuthProvider")
+  return v
+}
+
+/** Turns API errors into the messages the existing pages already look for (they were written against Supabase's wording). */
+export function toLegacyError(e: unknown): Error {
+  if (e instanceof ApiError) {
+    if (e.isNetwork) return new Error("Network error. Please check your connection.")
+    if (e.code === "invalid_credentials") return new Error("Invalid login credentials")
+    if (e.code === "email_not_verified") return new Error("Email not confirmed")
+    if (e.status === 429) return new Error("Too many requests")
+    return new Error(e.message)
+  }
+  return e instanceof Error ? e : new Error("Something went wrong.")
+}
+
+function legacyBusiness(m: Membership, details: Record<string, any> | null, userId: string): Business {
+  const d = details ?? {}
+  return {
+    id: m.business_id,
+    name: d.name ?? m.name,
+    user_id: m.role === "owner" ? userId : "",
+    owner_id: m.role === "owner" ? userId : null,
+    plan: d.effective_plan ?? m.effective_plan ?? m.plan ?? "free",
+    plan_status: d.plan_status ?? m.plan_status ?? "active",
+    plan_expiry: d.plan_expiry ?? m.plan_expiry ?? null,
+    paystack_customer_id: null,
+    tax_rate: d.tax_rate !== undefined && d.tax_rate !== null ? Number(d.tax_rate) : undefined,
+    created_at: d.created_at ?? "",
+    updated_at: d.updated_at ?? d.created_at ?? "",
+  }
+}
+
+export const ApiAuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
+  const [me, setMe] = useState<Me | null>(null)
+  const [businessId, setBusinessId] = useState<string | null>(null)
+  const [businessDetails, setBusinessDetails] = useState<Record<string, any> | null>(null)
+  const [loading, setLoading] = useState(true)
+
+  const loadBusiness = useCallback(async (id: string) => {
+    try {
+      const r = await api().get<Record<string, any>>(`/businesses/${id}`)
+      setBusinessDetails(r.data)
+    } catch (e) {
+      console.error("Error loading business:", e)
+      setBusinessDetails(null)
+    }
+  }, [])
+
+  const adopt = useCallback(async (next: Me) => {
+    setMe(next)
+    const remembered = api().businessId
+    const pick = next.memberships.find((m) => m.business_id === remembered) ?? next.memberships[0] ?? null
+    if (pick) {
+      api().setBusiness(pick.business_id)
+      setBusinessId(pick.business_id)
+      await loadBusiness(pick.business_id)
+    } else {
+      setBusinessId(null)
+      setBusinessDetails(null)
+    }
+  }, [loadBusiness])
+
+  const clear = useCallback(() => {
+    setMe(null)
+    setBusinessId(null)
+    setBusinessDetails(null)
+  }, [])
+
+  useEffect(() => {
+    let alive = true
+    const off = onSessionExpired(() => { if (alive) clear() })
+    ;(async () => {
+      try {
+        const resumed = await api().resume()
+        if (alive && resumed) await adopt(resumed)
+      } catch (e) {
+        console.error("Error restoring session:", e) // offline at start-up: stay signed out locally, the token is kept
+      } finally {
+        if (alive) setLoading(false)
+      }
+    })()
+    return () => { alive = false; off() }
+  }, [adopt, clear])
+
+  const signIn: AuthContextType["signIn"] = async (email, password) => {
+    try {
+      const next = await api().login(email, password)
+      await adopt({ user: next.user, memberships: next.memberships })
+      return { error: null, user: toUser(next.user), session: toSession(next.user) }
+    } catch (e) {
+      return { error: toLegacyError(e) }
+    }
+  }
+
+  const signUp: AuthContextType["signUp"] = async (email, password, businessData) => {
+    try {
+      const b = businessData ?? {}
+      await api().post(
+        "/auth/register",
+        {
+          email: email.trim(),
+          password,
+          full_name: b.full_name,
+          business_name: b.business_name,
+          business_type: b.business_type,
+          currency: b.currency,
+          phone: b.phone_number,
+        },
+        { anonymous: true },
+      )
+      // The API answers 202 and e-mails a verification link: there is no session until the address is verified.
+      return { error: null, user: null, session: null }
+    } catch (e) {
+      const err = toLegacyError(e)
+      if (e instanceof ApiError && e.code === "validation_failed") {
+        const first = Object.values(e.fields)[0]?.[0]
+        if (first) return { error: new Error(first) }
+      }
+      return { error: err }
+    }
+  }
+
+  const signOut = async () => {
+    await api().logout()
+    clear()
+  }
+
+  const resetPassword = async (email: string) => {
+    try {
+      await api().post("/auth/forgot-password", { email: email.trim() }, { anonymous: true })
+      return { error: null }
+    } catch (e) {
+      return { error: toLegacyError(e) }
+    }
+  }
+
+  const updateProfile: AuthContextType["updateProfile"] = async (updates) => {
+    try {
+      const body: Record<string, unknown> = {}
+      if (updates.full_name !== undefined) body.full_name = updates.full_name
+      if (updates.phone_number !== undefined) body.phone = updates.phone_number
+      if (updates.address !== undefined) body.address = updates.address
+      if (updates.currency !== undefined) body.currency = updates.currency
+      await api().patch("/me", body, { noBusiness: true })
+      const fresh = await api().me()
+      setMe(fresh)
+      return { error: null }
+    } catch (e) {
+      return { error: toLegacyError(e) }
+    }
+  }
+
+  const selectBusiness = useCallback(async (id: string) => {
+    api().setBusiness(id)
+    setBusinessId(id)
+    await loadBusiness(id)
+  }, [loadBusiness])
+
+  const reloadMemberships = useCallback(async () => {
+    const fresh = await api().me()
+    setMe(fresh)
+  }, [])
+
+  const session = useMemo<ApiSessionValue>(() => ({
+    me,
+    memberships: me?.memberships ?? [],
+    businessId,
+    businessDetails,
+    loading,
+    selectBusiness,
+    reloadBusiness: async () => { if (businessId) await loadBusiness(businessId) },
+    reloadMemberships,
+  }), [me, businessId, businessDetails, loading, selectBusiness, loadBusiness, reloadMemberships])
+
+  const membership = me?.memberships.find((m) => m.business_id === businessId) ?? null
+  const value: AuthContextType = {
+    user: me ? toUser(me.user) : null,
+    session: me ? toSession(me.user) : null,
+    profile: me
+      ? {
+          id: me.user.id,
+          email: me.user.email,
+          full_name: me.user.full_name,
+          business_name: membership?.name ?? null,
+          business_type: null,
+          currency: membership?.currency ?? me.user.currency ?? "NGN",
+          phone_number: me.user.phone,
+          address: me.user.address,
+          role: membership?.role ?? "owner",
+          created_at: "",
+          updated_at: "",
+        }
+      : null,
+    business: me && membership ? (legacyBusiness(membership, businessDetails, me.user.id) as any) : null,
+    loading,
+    role: membership?.role ?? null,
+    signIn,
+    signUp,
+    signOut,
+    updateProfile,
+    resetPassword,
+  }
+
+  useEffect(() => {
+    try { if (value.profile?.currency) localStorage.setItem("currency", value.profile.currency) } catch { /* storage blocked */ }
+  }, [value.profile?.currency])
+
+  return (
+    <ApiSessionContext.Provider value={session}>
+      <AuthContext.Provider value={value}>{children}</AuthContext.Provider>
+    </ApiSessionContext.Provider>
+  )
+}
+
+/** The shape pages expect from supabase-js's `User`/`Session`, limited to the fields they actually read. */
+function toUser(u: Me["user"]): any {
+  return { id: u.id, email: u.email, email_confirmed_at: u.email_verified ? new Date().toISOString() : null, user_metadata: { full_name: u.full_name, name: u.full_name } }
+}
+function toSession(u: Me["user"]): any {
+  return { user: toUser(u), access_token: "" }
+}
+
+export const ApiBusinessProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
+  const s = useApiSession()
+  const userId = s.me?.user.id ?? ""
+
+  const businesses: Business[] = useMemo(
+    () => s.memberships.map((m) => legacyBusiness(m, m.business_id === s.businessId ? s.businessDetails : null, userId)),
+    [s.memberships, s.businessId, s.businessDetails, userId],
+  )
+  const business = businesses.find((b) => b.id === s.businessId) ?? null
+
+  const value: BusinessContextType = {
+    business,
+    businesses,
+    loading: s.loading,
+    createBusiness: async (data) => {
+      try {
+        await api().post("/businesses", { name: data.name, business_type: "other", currency: "NGN" }, { noBusiness: true })
+        await s.reloadMemberships()
+        return { error: null }
+      } catch (e) {
+        return { error: toLegacyError(e) }
+      }
+    },
+    updateBusiness: async (businessId, updates) => {
+      try {
+        const body: Record<string, unknown> = {}
+        if (updates.name !== undefined) body.name = updates.name
+        if (updates.tax_rate !== undefined) body.tax_rate = String(updates.tax_rate)
+        await api().patch(`/businesses/${businessId}`, body)
+        await s.reloadBusiness()
+        return { error: null }
+      } catch (e) {
+        return { error: toLegacyError(e) }
+      }
+    },
+    switchBusiness: (id) => { void s.selectBusiness(id) },
+    refreshBusinesses: async () => { await s.reloadMemberships(); await s.reloadBusiness() },
+  }
+
+  return <BusinessContext.Provider value={value}>{children}</BusinessContext.Provider>
+}
