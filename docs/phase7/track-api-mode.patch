+ */
+export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) =>
+  isApiMode() ? <ApiAuthProvider>{children}</ApiAuthProvider> : <LegacyAuthProvider>{children}</LegacyAuthProvider>
