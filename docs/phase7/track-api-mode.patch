+/**
+ * Which backend this build talks to.
+ *   NEXT_PUBLIC_API_BASE_URL unset  -> "legacy": exactly the existing Supabase behaviour (this is what production runs today).
+ *   NEXT_PUBLIC_API_BASE_URL set    -> "api": the LeenTrack PHP API (https://…/api/v1).
+ * The value is inlined at BUILD time, so a deployment can never switch backends by accident at runtime.
+ */
+export const API_BASE_URL: string = (process.env.NEXT_PUBLIC_API_BASE_URL ?? "").trim()
+
+export function isApiMode(): boolean {
+  return API_BASE_URL !== ""
+}
+
+/**
+ * Screens that have been moved onto the API. In API mode every other protected screen shows a notice instead of silently calling a
+ * backend that does not exist for it. Grow this list as pages move (docs/16 in the rebuild repository tracks the order).
+ */
+export const MIGRATED_ROUTES: readonly string[] = ["/inventory"]
+
+export function isRouteMigrated(pathname: string | null | undefined): boolean {
+  if (!pathname) return false
+  return MIGRATED_ROUTES.some((r) => pathname === r || pathname.startsWith(r + "/"))
+}
