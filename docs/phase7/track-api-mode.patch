@@ -205,6 +205,38 @@ test("validation errors keep their per-field messages; non-JSON answers become b
   await assert.rejects(() => client.get("/html"), (e: any) => e.code === "bad_response" && e.status === 502)
 })
 
+test("two TABS (separate clients, one shared store) refreshing at once do not sign each other out when they share a lock", async () => {
+  const s = server()
+  s.refreshDelayMs = 15
+  const store = new MemoryTokenStore()
+  // a simple mutex standing in for navigator.locks
+  let tail: Promise<unknown> = Promise.resolve()
+  const lock = <T,>(fn: () => Promise<T>): Promise<T> => { const run = tail.then(fn, fn); tail = run.catch(() => {}); return run }
+  const mk = () => new ApiClient({ baseUrl: "http://x/api/v1", store, fetchImpl: s.fetch as any, lock })
+  const a = mk(), b = mk()
+  await a.login("a@b.c", "right")
+  await b.resume() // tab B signs in from the stored token (rotates it once)
+  s.validAccess = "stale-for-everyone"
+  const [ra, rb] = await Promise.all([a.get("/x"), b.get("/y")])
+  assert.equal(ra.data.path, "/x")
+  assert.equal(rb.data.path, "/y")
+  assert.notEqual(store.getRefreshToken(), null, "nobody was signed out")
+})
+
+test("WITHOUT a shared lock the same two tabs DO collide (this is why the lock exists)", async () => {
+  const s = server()
+  s.refreshDelayMs = 15
+  const store = new MemoryTokenStore()
+  const noLock = <T,>(fn: () => Promise<T>) => fn()
+  const mk = () => new ApiClient({ baseUrl: "http://x/api/v1", store, fetchImpl: s.fetch as any, lock: noLock })
+  const a = mk(), b = mk()
+  await a.login("a@b.c", "right")
+  await b.resume()
+  s.validAccess = "stale-for-everyone"
+  const results = await Promise.allSettled([a.get("/x"), b.get("/y")])
+  assert.ok(results.some((r) => r.status === "rejected"), "one tab loses the race and is refused")
+})
+
