diff --git a/lib/api/client.test.ts b/lib/api/client.test.ts
new file mode 100644
index 0000000..62e6a44
--- /dev/null
+++ b/lib/api/client.test.ts
@@ -0,0 +1,232 @@
+// Run with: node --test --experimental-strip-types lib/api/client.test.ts
+// The fake-fetch tests run anywhere. The "real API" tests run only when LT_E2E_URL is set (see tools/e2e in the rebuild repository).
+import test from "node:test"
+import assert from "node:assert/strict"
+import { ApiClient } from "./client.ts"
+import { ApiError } from "./errors.ts"
+import { MemoryTokenStore } from "./token-store.ts"
+
+type Call = { method: string; url: string; headers: Record<string, string>; body: any }
+
+function ok(data: unknown, status = 200, meta: any = {}) {
+  return new Response(JSON.stringify({ ok: true, data, meta }), { status, headers: { "Content-Type": "application/json" } })
+}
+function fail(status: number, code: string, message = code, fields?: any) {
+  return new Response(JSON.stringify({ ok: false, error: { code, message, fields } }), { status, headers: { "Content-Type": "application/json" } })
+}
+
+/** A scriptable server at the fetch level; everything in ApiClient is the real code. */
+function server() {
+  const s = {
+    calls: [] as Call[],
+    validAccess: "a1",
+    validRefresh: "r1",
+    refreshes: 0,
+    refreshRefused: false,
+    down: false,
+    refreshDelayMs: 0,
+    fetch: async (url: any, init: any = {}): Promise<Response> => {
+      if (s.down) throw new TypeError("Failed to fetch")
+      const u = new URL(String(url))
+      const path = u.pathname.replace(/^\/api\/v1/, "")
+      const body = init.body ? JSON.parse(init.body) : undefined
+      s.calls.push({ method: init.method, url: String(url), headers: { ...(init.headers ?? {}) }, body })
+      if (path === "/auth/login") {
+        return body.password === "right"
+          ? ok({ access_token: s.validAccess, refresh_token: s.validRefresh, user: { id: "u1", email: body.email }, memberships: [{ business_id: "b1", name: "Shop", role: "owner", currency: "NGN" }], session_id: "s1" })
+          : fail(401, "invalid_credentials", "Invalid e-mail or password.")
+      }
+      if (path === "/auth/refresh") {
+        await new Promise((r) => setTimeout(r, s.refreshDelayMs))
+        s.refreshes++
+        if (s.refreshRefused || body.refresh_token !== s.validRefresh) return fail(401, "token_invalid")
+        s.validAccess = `a${s.refreshes + 1}`
+        s.validRefresh = `r${s.refreshes + 1}`
+        return ok({ access_token: s.validAccess, refresh_token: s.validRefresh })
+      }
+      if ((init.headers ?? {})["Authorization"] !== `Bearer ${s.validAccess}`) return fail(401, "token_invalid")
+      if (path === "/me") return ok({ user: { id: "u1", email: "a@b.c" }, memberships: [{ business_id: "b1", name: "Shop", role: "owner", currency: "NGN" }] })
+      if (path === "/auth/logout") return ok({})
+      return ok({ path, business: (init.headers ?? {})["X-Business-Id"] ?? null, query: u.search })
+    },
+  }
+  return s
+}
+
+function make(s = server(), opts: { expired?: () => void } = {}) {
+  const store = new MemoryTokenStore()
+  const client = new ApiClient({ baseUrl: "http://x/api/v1/", store, fetchImpl: s.fetch as any, onSessionExpired: opts.expired, device: { id: "web-1", name: "LeenTrack web", platform: "web" } })
+  return { s, store, client }
+}
+
+test("login stores only the refresh token, sends the device, and the base URL tolerates a trailing slash", async () => {
+  const { s, store, client } = make()
+  const me = await client.login(" ada@x.com ", "right")
+  assert.equal(me.memberships[0].role, "owner")
+  assert.equal(store.getRefreshToken(), "r1")
+  assert.deepEqual(s.calls[0].body.device, { id: "web-1", name: "LeenTrack web", platform: "web" })
+  assert.equal(s.calls[0].body.email, "ada@x.com")
+  assert.equal(s.calls[0].url, "http://x/api/v1/auth/login")
+  assert.equal(s.calls[0].headers["Authorization"], undefined, "login is anonymous")
+})
+
+test("a wrong password raises the server's message and stores nothing", async () => {
+  const { store, client } = make()
+  await assert.rejects(() => client.login("a@b.c", "nope"), (e: any) => e instanceof ApiError && e.code === "invalid_credentials" && e.status === 401)
+  assert.equal(store.getRefreshToken(), null)
+  assert.equal(client.hasAccessToken, false)
+})
+
+test("requests carry the bearer token and the chosen business, and query values are encoded (undefined/null dropped)", async () => {
+  const { s, client } = make()
+  await client.login("a@b.c", "right")
+  client.setBusiness("b1")
+  const r = await client.get("/products", { search: "a&b c", page: 2, none: undefined, nil: null })
+  assert.equal(r.data.business, "b1")
+  assert.equal(r.data.query, "?search=a%26b+c&page=2")
+  const last = s.calls[s.calls.length - 1]
+  assert.equal(last.headers["Authorization"], "Bearer a1")
+})
+
+test("/me is not sent with a business header", async () => {
+  const { s, client } = make()
+  await client.login("a@b.c", "right")
+  client.setBusiness("b1")
+  await client.me()
+  assert.equal(s.calls[s.calls.length - 1].headers["X-Business-Id"], undefined)
+})
+
+test("an expired access token is renewed transparently, the request is repeated once, and the rotated refresh token is saved", async () => {
+  const { s, store, client } = make()
+  await client.login("a@b.c", "right")
+  s.validAccess = "rotated-elsewhere"
+  const r = await client.get("/products")
+  assert.equal(r.data.path, "/products")
+  assert.equal(s.refreshes, 1)
+  assert.equal(store.getRefreshToken(), "r2", "the new refresh token must be saved or the next renewal would fail")
+})
+
+test("ten requests that all notice the expiry cause ONE refresh (single flight)", async () => {
+  const { s, client } = make()
+  await client.login("a@b.c", "right")
+  s.validAccess = "stale"
+  s.refreshDelayMs = 30
+  const rs = await Promise.all(Array.from({ length: 10 }, (_, i) => client.get(`/x${i}`)))
+  assert.equal(rs.length, 10)
+  assert.equal(s.refreshes, 1, "a second refresh with the already-rotated token would sign the person out")
+})
+
+test("a refused refresh token ends the session once and the original error is raised", async () => {
+  let expired = 0
+  const { s, store, client } = make(server(), { expired: () => expired++ })
+  await client.login("a@b.c", "right")
+  s.validAccess = "stale"
+  s.refreshRefused = true
+  await assert.rejects(() => client.get("/products"), (e: any) => e.status === 401)
+  assert.equal(expired, 1)
+  assert.equal(store.getRefreshToken(), null)
+  assert.equal(client.hasAccessToken, false)
+})
+
+test("being offline during a refresh is NOT treated as being signed out", async () => {
+  let expired = 0
+  const { s, store, client } = make(server(), { expired: () => expired++ })
+  await client.login("a@b.c", "right")
+  s.validAccess = "stale"
+  s.down = true
+  await assert.rejects(() => client.get("/products"), (e: any) => e instanceof ApiError && e.isNetwork)
+  assert.equal(expired, 0)
+  assert.equal(store.getRefreshToken(), "r1")
+})
+
+test("a 401 that is not about the token (e.g. wrong password on change-password) is not retried or refreshed", async () => {
+  const s = server()
+  const orig = s.fetch
+  s.fetch = async (url: any, init: any) => (String(url).endsWith("/me/change-password") ? fail(401, "invalid_credentials", "Current password is incorrect.") : orig(url, init))
+  const { client } = make(s)
+  await client.login("a@b.c", "right")
+  await assert.rejects(() => client.post("/me/change-password", { current_password: "x", new_password: "y" }), (e: any) => e.code === "invalid_credentials")
+  assert.equal(s.refreshes, 0)
+})
+
+test("resume signs in again from the stored refresh token and rotates it; nothing stored or a refused token gives null", async () => {
+  const { s, store, client } = make()
+  assert.equal(await client.resume(), null)
+  store.setRefreshToken("r1")
+  const me = await client.resume()
+  assert.equal(me?.memberships[0].business_id, "b1")
+  assert.equal(store.getRefreshToken(), "r2")
+  store.setRefreshToken("garbage")
+  assert.equal(await client.resume(), null)
+  assert.equal(store.getRefreshToken(), null)
+  void s
+})
+
+test("two resumes at the same moment share one refresh (the refresh token is single-use)", async () => {
+  const { s, store, client } = make()
+  s.refreshDelayMs = 20
+  store.setRefreshToken("r1")
+  const [a, b] = await Promise.all([client.resume(), client.resume()])
+  assert.ok(a && b, "both callers are signed in")
+  assert.equal(s.refreshes, 1, "a second refresh with the already-rotated token would have signed the person out")
+  assert.equal(store.getRefreshToken(), "r2")
+})
+
+test("resume while offline throws a network error and keeps the stored token", async () => {
+  const { s, store, client } = make()
+  store.setRefreshToken("r1")
+  s.down = true
+  await assert.rejects(() => client.resume(), (e: any) => e.isNetwork)
+  assert.equal(store.getRefreshToken(), "r1")
+})
+
+test("logout clears everything even when the server cannot be reached", async () => {
+  const { s, store, client } = make()
+  await client.login("a@b.c", "right")
+  client.setBusiness("b1")
+  s.down = true
+  await client.logout()
+  assert.equal(store.getRefreshToken(), null)
+  assert.equal(store.getBusinessId(), null)
+  assert.equal(client.hasAccessToken, false)
+})
+
+test("validation errors keep their per-field messages; non-JSON answers become bad_response", async () => {
+  const s = server()
+  const orig = s.fetch
+  s.fetch = async (url: any, init: any) => {
+    if (String(url).endsWith("/customers")) return fail(422, "validation_failed", "The given data was invalid.", { name: ["Required."], email: "Bad address." })
+    if (String(url).endsWith("/html")) return new Response("<html>502</html>", { status: 502 })
+    return orig(url, init)
+  }
+  const { client } = make(s)
+  await client.login("a@b.c", "right")
+  await assert.rejects(() => client.post("/customers", {}), (e: any) => e.status === 422 && e.fields.name[0] === "Required." && e.fields.email[0] === "Bad address.")
+  await assert.rejects(() => client.get("/html"), (e: any) => e.code === "bad_response" && e.status === 502)
+})
+
+// ------------------------------------------------------------------------------------------------- real API (env-gated)
+const REAL = process.env.LT_E2E_URL
+test("real API: register, sign in, read the profile, call a business endpoint, refresh after rotation, and sign out", { skip: REAL ? false : "set LT_E2E_URL (tools/e2e/run-web.sh)" }, async () => {
+  const store = new MemoryTokenStore()
+  const client = new ApiClient({ baseUrl: REAL!, store, device: { id: "web-test-1", name: "LeenTrack web", platform: "web" } })
+  const email = `web-${Date.now()}-${Math.random().toString(36).slice(2, 7)}@example.test`
+  const reg = await client.post("/auth/register", { email, password: "Correct-Horse-9", full_name: "Web Owner", business_name: "Web Shop", business_type: "retail", currency: "NGN" }, { anonymous: true })
+  assert.ok(reg.status === 202 || reg.status === 201)
+  const me = await client.login(email, "Correct-Horse-9")
+  assert.equal(me.memberships[0].role, "owner")
+  client.setBusiness(me.memberships[0].business_id)
+  const prod = await client.post("/products", { name: "Soap", selling_price: "100.00", cost_price: "60.00", stock_quantity: 5 })
+  const list = await client.get<any[]>("/products")
+  assert.ok(list.data.some((p) => p.id === prod.data.id))
+  // force an expired access token: drop it and let the next call renew it
+  ;(client as any).access = "expired-garbage"
+  const again = await client.get<any[]>("/products")
+  assert.equal(again.data.length, list.data.length)
+  assert.notEqual(store.getRefreshToken(), null)
+  const me2 = await client.me()
+  assert.equal(me2.user.email, email)
+  await client.logout()
+  assert.equal(client.hasAccessToken, false)
+  await assert.rejects(() => client.get("/products"), (e: any) => e.status === 401)
+})
diff --git a/lib/api/client.ts b/lib/api/client.ts
new file mode 100644
index 0000000..e632882
--- /dev/null
+++ b/lib/api/client.ts
@@ -0,0 +1,237 @@
+import { ApiError } from "./errors.ts"
+import type { TokenStore } from "./token-store.ts"
+
+export interface ApiResult<T = unknown> {
+  data: T
+  meta: Record<string, any>
+  status: number
+}
+
+export interface Membership {
+  business_id: string
+  name: string
+  role: string
+  currency: string
+  plan?: string
+  plan_status?: string
+  plan_expiry?: string | null
+  effective_plan?: string
+}
+
+export interface ApiUser {
+  id: string
+  email: string
+  full_name: string | null
+  phone: string | null
+  address: string | null
+  currency: string
+  must_change_password: boolean
+  [k: string]: any
+}
+
+export interface Me {
+  user: ApiUser
+  memberships: Membership[]
+}
+
+export interface ClientOptions {
+  baseUrl: string
+  store: TokenStore
+  fetchImpl?: typeof fetch
+  /** Called when even the refresh token was refused: the person must sign in again. */
+  onSessionExpired?: () => void
+  /** Identifies this browser to the server's session list. */
+  device?: { id: string; name: string; platform: string }
+}
+
+type RequestOptions = {
+  body?: unknown
+  query?: Record<string, string | number | boolean | undefined | null>
+  headers?: Record<string, string>
+  /** Some calls (login, register, health) must not send the business or the bearer token. */
+  anonymous?: boolean
+  /** Calls that are not about one business (profile, memberships) leave the business header off. */
+  noBusiness?: boolean
+}
+
+const EXPIRED_CODES = new Set(["token_invalid", "token_expired", "unauthenticated"])
+
+/**
+ * Thin client over the LeenTrack envelope `{ok,data,meta}` / `{ok:false,error}`.
+ * Adds the bearer token and X-Business-Id, renews an expired access token ONCE however many requests notice at the same moment
+ * (the server rotates the refresh token on each use, so two parallel refreshes would sign the person out), and treats being offline as
+ * "offline", never as "signed out".
+ */
+export class ApiClient {
+  readonly baseUrl: string
+  private readonly store: TokenStore
+  private readonly fetchImpl: typeof fetch
+  private readonly onSessionExpired?: () => void
+  private readonly device?: ClientOptions["device"]
+  private access: string | null = null
+  private refreshing: Promise<boolean> | null = null
+  private resuming: Promise<Me | null> | null = null
+  businessId: string | null
+
+  constructor(o: ClientOptions) {
+    this.baseUrl = o.baseUrl.replace(/\/+$/, "")
+    this.store = o.store
+    this.fetchImpl = o.fetchImpl ?? ((...a) => fetch(...a))
+    this.onSessionExpired = o.onSessionExpired
+    this.device = o.device
+    this.businessId = o.store.getBusinessId()
+  }
+
+  get hasAccessToken(): boolean {
+    return this.access !== null
+  }
+
+  setBusiness(id: string | null) {
+    this.businessId = id
+    if (id) this.store.setBusinessId(id)
+  }
+
+  // ------------------------------------------------------------------ requests
+  async request<T = any>(method: string, path: string, opt: RequestOptions = {}): Promise<ApiResult<T>> {
+    try {
+      return await this.once<T>(method, path, opt)
+    } catch (e) {
+      if (opt.anonymous || !(e instanceof ApiError) || e.status !== 401 || !EXPIRED_CODES.has(e.code)) throw e
+      if (!(await this.refresh())) throw e
+      return this.once<T>(method, path, opt)
+    }
+  }
+
+  get<T = any>(path: string, query?: RequestOptions["query"], opt: Omit<RequestOptions, "query" | "body"> = {}) {
+    return this.request<T>("GET", path, { ...opt, query })
+  }
+  post<T = any>(path: string, body?: unknown, opt: Omit<RequestOptions, "body"> = {}) {
+    return this.request<T>("POST", path, { ...opt, body })
+  }
+  patch<T = any>(path: string, body?: unknown, opt: Omit<RequestOptions, "body"> = {}) {
+    return this.request<T>("PATCH", path, { ...opt, body })
+  }
+  put<T = any>(path: string, body?: unknown, opt: Omit<RequestOptions, "body"> = {}) {
+    return this.request<T>("PUT", path, { ...opt, body })
+  }
+  delete<T = any>(path: string, opt: RequestOptions = {}) {
+    return this.request<T>("DELETE", path, opt)
+  }
+
+  private async once<T>(method: string, path: string, opt: RequestOptions): Promise<ApiResult<T>> {
+    const headers: Record<string, string> = { Accept: "application/json", ...(opt.headers ?? {}) }
+    if (opt.body !== undefined) headers["Content-Type"] = "application/json"
+    if (!opt.anonymous) {
+      if (this.access) headers["Authorization"] = `Bearer ${this.access}`
+      if (!opt.noBusiness && this.businessId) headers["X-Business-Id"] = this.businessId
+    }
+    let url = this.baseUrl + path
+    if (opt.query) {
+      const qs = new URLSearchParams()
+      for (const [k, v] of Object.entries(opt.query)) if (v !== undefined && v !== null) qs.set(k, String(v))
+      const s = qs.toString()
+      if (s) url += (url.includes("?") ? "&" : "?") + s
+    }
+    let res: Response
+    try {
+      res = await this.fetchImpl(url, { method, headers, body: opt.body === undefined ? undefined : JSON.stringify(opt.body) })
+    } catch {
+      throw new ApiError({ code: "network_error", message: "Cannot reach the server." })
+    }
+    let json: any = null
+    try { json = await res.json() } catch { /* not JSON */ }
+    if (!json || typeof json.ok !== "boolean") {
+      throw new ApiError({ code: "bad_response", message: "Unexpected response from the server.", status: res.status })
+    }
+    if (json.ok) return { data: json.data as T, meta: json.meta ?? {}, status: res.status }
+    const err = json.error ?? {}
+    const fields: Record<string, string[]> = {}
+    for (const [k, v] of Object.entries(err.fields ?? {})) fields[k] = Array.isArray(v) ? v.map(String) : [String(v)]
+    throw new ApiError({ code: err.code ?? "error", message: err.message ?? "Request failed.", status: res.status, fields, requestId: json.meta?.request_id ?? null })
+  }
+
+  // ------------------------------------------------------------------ session
+  /** Single flight: concurrent callers share one refresh. Returns false when the person must sign in again. */
+  private refresh(): Promise<boolean> {
+    if (!this.refreshing) this.refreshing = this.doRefresh().finally(() => { this.refreshing = null })
+    return this.refreshing
+  }
+
+  private async doRefresh(): Promise<boolean> {
+    const rt = this.store.getRefreshToken()
+    if (!rt) { this.expire(); return false }
+    try {
+      const r = await this.once<{ access_token: string; refresh_token: string }>("POST", "/auth/refresh", { body: { refresh_token: rt }, anonymous: true })
+      this.access = r.data.access_token
+      this.store.setRefreshToken(r.data.refresh_token) // rotated: the old one is now useless
+      return true
+    } catch (e) {
+      if (e instanceof ApiError && e.isNetwork) return false // offline is not "signed out"
+      this.expire()
+      return false
+    }
+  }
+
+  private expire() {
+    this.access = null
+    this.store.clear()
+    this.onSessionExpired?.()
+  }
+
+  async login(email: string, password: string): Promise<Me & { session_id?: string }> {
+    const r = await this.once<any>("POST", "/auth/login", {
+      anonymous: true,
+      body: { email: email.trim(), password, ...(this.device ? { device: this.device } : {}) },
+    })
+    this.access = r.data.access_token
+    this.store.setRefreshToken(r.data.refresh_token)
+    return { user: r.data.user, memberships: r.data.memberships ?? [], session_id: r.data.session_id }
+  }
+
+  /** Signs in again from the stored refresh token (page reload). Null when there is none or it was refused; throws only when offline. */
+  resume(): Promise<Me | null> {
+    // Single flight: React (dev strict mode) and quick reloads can ask twice at once, and the refresh token is single-use.
+    if (!this.resuming) this.resuming = this.doResume().finally(() => { this.resuming = null })
+    return this.resuming
+  }
+
+  private async doResume(): Promise<Me | null> {
+    const rt = this.store.getRefreshToken()
+    if (!rt) return null
+    try {
+      const r = await this.once<{ access_token: string; refresh_token: string }>("POST", "/auth/refresh", { body: { refresh_token: rt }, anonymous: true })
+      this.access = r.data.access_token
+      this.store.setRefreshToken(r.data.refresh_token)
+      return (await this.me())
+    } catch (e) {
+      if (e instanceof ApiError && e.isNetwork) throw e
+      this.access = null
+      this.store.clear()
+      return null
+    }
+  }
+
+  async me(): Promise<Me> {
+    const r = await this.get<Me>("/me", undefined, { noBusiness: true })
+    return { user: r.data.user, memberships: r.data.memberships ?? [] }
+  }
+
+  async logout(): Promise<void> {
+    try { await this.post("/auth/logout", undefined, { noBusiness: true }) } catch { /* signing out must work offline too */ }
+    this.access = null
+    this.businessId = null
+    this.store.clear()
+  }
+}
+
+/** Reads every page of a list endpoint (the API caps a page at 200 rows). */
+export async function fetchAll<T = any>(client: ApiClient, path: string, query: Record<string, string | number | boolean | undefined | null> = {}): Promise<T[]> {
+  const out: T[] = []
+  for (let page = 1; page <= 500; page++) {
+    const r = await client.get<T[]>(path, { ...query, per_page: 200, page })
+    out.push(...r.data)
+    const total = Number(r.meta?.total ?? out.length)
+    if (out.length >= total || r.data.length === 0) break
+  }
+  return out
+}
