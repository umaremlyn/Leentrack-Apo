+import { ApiClient } from "./client.ts"
+import { API_BASE_URL } from "./mode.ts"
+import { LocalStorageTokenStore } from "./token-store.ts"
+
+export { ApiClient } from "./client.ts"
+export type { ApiResult, Me, Membership, ApiUser } from "./client.ts"
+export { fetchAll } from "./client.ts"
+export { ApiError } from "./errors.ts"
+export { isApiMode, API_BASE_URL } from "./mode.ts"
+export { LocalStorageTokenStore, MemoryTokenStore } from "./token-store.ts"
+export type { TokenStore } from "./token-store.ts"
+
+let instance: ApiClient | null = null
+let expiredListeners: Array<() => void> = []
+
+/** Called by the auth provider so a refused refresh token returns the person to the sign-in page. */
+export function onSessionExpired(fn: () => void): () => void {
+  expiredListeners.push(fn)
+  return () => { expiredListeners = expiredListeners.filter((x) => x !== fn) }
+}
+
+/** The one shared client for the browser. Throws if the build is in legacy mode (no API address configured). */
+export function api(): ApiClient {
+  if (!API_BASE_URL) throw new Error("NEXT_PUBLIC_API_BASE_URL is not set: this build uses the legacy backend.")
+  if (!instance) {
+    instance = new ApiClient({
+      baseUrl: API_BASE_URL,
+      store: new LocalStorageTokenStore(),
+      onSessionExpired: () => expiredListeners.forEach((f) => f()),
+      device: { id: deviceId(), name: "LeenTrack web", platform: "web" },
+    })
+  }
+  return instance
+}
+
+function deviceId(): string {
+  try {
+    const k = "lt_device_id"
+    let v = window.localStorage.getItem(k)
+    if (!v) {
+      v = "web-" + (crypto.randomUUID?.() ?? Math.random().toString(36).slice(2) + Date.now().toString(36))
+      window.localStorage.setItem(k, v)
+    }
+    return v
+  } catch {
+    return "web-" + Math.random().toString(36).slice(2)
+  }
+}
+
+/** A UUID for operations that must be safe to retry (sales, repayments, receipts, transfers). */
+export function newOperationId(): string {
+  return crypto.randomUUID()
+}
