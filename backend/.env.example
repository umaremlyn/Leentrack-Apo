# Copy to .env (OUTSIDE the web root in production) and chmod 600.
APP_ENV=production            # production | staging | local | testing
APP_DEBUG=false               # MUST be false in production (boot check enforces this)
APP_URL=https://api.example.com
APP_KEY=                      # base64:32 random bytes — php bin/keygen.php
TIMEZONE_DB=+00:00

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leentrack
DB_USER=leentrack
DB_PASS=
DB_SOCKET=

CORS_ALLOWED_ORIGINS=https://track.example.com   # comma-separated, no wildcard
TRUSTED_PROXIES=                                  # comma-separated IPs allowed to set X-Forwarded-For
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

WEB_URL=https://track.example.com          # base URL used in e-mailed links (verify, reset, invite)
MAIL_FROM="LeenTrack <no-reply@example.com>"
# MAIL_DRIVER: smtp (recommended: authenticated, passes SPF/DKIM), native (PHP mail() via the host's sendmail), file (dev: writes to storage/logs/mail.log)
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# Paystack (billing). Secret key = server only. Webhook URL to register in the Paystack dashboard: https://YOUR-API-HOST/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
PAYMENT_RETENTION_YEARS=7
# Where profile pictures are stored (outside the web root; default storage/avatars)
# AVATAR_DIR=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
REQUIRE_EMAIL_VERIFICATION=true
ENFORCE_SALES_LIMIT=false              # true = refuse new sales once the plan's sales limit is reached (source only warned)
