{
  "name": "leentrack/api",
  "description": "LeenTrack PHP REST API (shared-hosting friendly, no runtime dependencies)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": { "psr-4": { "LeenTrack\\": "app/" } },
  "autoload-dev": { "psr-4": { "LeenTrack\\Tests\\": "tests/" } },
  "config": { "optimize-autoloader": true, "sort-packages": true },
  "scripts": {
    "test": "phpunit --colors=always",
    "migrate": "@php bin/migrate.php up"
  }
}
